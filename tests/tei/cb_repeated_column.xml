<TEI xmlns="http://www.tei-c.org/ns/1.0">
    <teiHeader>
        <encodingDesc>
            <refsDecl>
                <citeStructure unit="column" match="//body//cb" use="@n">
                    <citeStructure unit="letter" match=".//milestone[@unit='letter']" use="@n" delim="."/>
                </citeStructure>
            </refsDecl>
        </encodingDesc>
    </teiHeader>
    <text>
        <body>
            <div>
                <!-- The text comes back to column 1 twice (e.g. letters printed out of order in the
                     Patrologia): letter B only exists under the later occurrences of column 1. -->
                <p><cb n="1"/><milestone unit="letter" n="A"/>Column one, A.</p>
                <p><cb n="2"/><milestone unit="letter" n="A"/>Column two, A.</p>
                <p><cb n="1"/><milestone unit="letter" n="B"/>Column one again, B.</p>
                <p><cb n="3"/><milestone unit="letter" n="A"/>Column three, A.</p>
                <p><cb n="1"/><milestone unit="letter" n="B"/>Column one a third time, B.</p>
            </div>
        </body>
    </text>
</TEI>
